# Configure os valores reais no painel Cloudflare, contexto Production.
APP_ORIGIN=https://ENDERECO_REAL_DO_SEU_APP
# Segunda origem exata autorizada para o Worker ativo durante a migração.
APP_ADDITIONAL_ORIGIN=https://SEU_DOMINIO_PROPRIO
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=CHAVE_PUBLICAVEL_DO_MESMO_PROJETO
# O Mentor gratuito não exige chave OpenAI, Resend ou segredo de créditos aqui.
